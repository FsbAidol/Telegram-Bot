# ============ Telegram Bot ============
# Токен бота от @BotFather. Обязателен.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID администраторов (через запятую), у кого есть права на:
# перезагрузку роутера, переключение радио-сетей, смену SSID/пароля.
# Если пусто — права даны всем пользователям.
ADMIN_IDS=

# ============ TP-Link Archer C80 ============
# Режим управления роутером:
#   cloud — реальный роутер через TP-Link Cloud (аккаунт из приложения Tether)
#   mock  — демонстрационный виртуальный роутер (данные без оборудования)
TPLINK_MODE=mock

# Логин и пароль от аккаунта TP-Link (тот же, что в приложении Tether).
# Нужны только в режиме cloud.
TPLINK_USER=
TPLINK_PASSWORD=

# Алиас роутера в аккаунте TP-Link (необязательно, если роутер единственный).
TPLINK_ALIAS=

# ============ Дополнительно ============
# URL Telegram-мини-приложения «Эмодзи-студия» (mini-app/).
# Показывает кнопку WebApp в главном меню. Бот требует HTTPS (или внутренний
# домен бота @BotFather → «Домен Mini App») — локально для теста можно без https.
MINI_APP_URL=http://localhost:8080

# Промежуток (сек) для авто-обновления кэша статуса роутера.
STATS_INTERVAL=60
