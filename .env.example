# ============ Telegram Bot ============
# Токен бота от @BotFather. Обязателен.
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ID администраторов (через запятую), у кого есть права на:
# перезагрузку роутера, переключение радио-сетей, смену SSID/пароля.
# Если пусто — права даны всем пользователям.
ADMIN_IDS=

# ============ TP-Link Archer C80 ============
# Режим управления роутером:
#   lan   — реальный роутер через локальный HTTP-API (рекомендуется;
#           бот должен быть в той же сети, что и роутер)
#   cloud — через TP-Link Cloud (устаревший API, может быть недоступен)
#   mock  — демонстрационный виртуальный роутер (данные без оборудования)
TPLINK_MODE=mock

# --- Режим lan (локальный HTTP-API) ---
# IP-адрес роутера (например, 192.168.0.1). Нужен, если TPLINK_MODE=lan.
TPLINK_HOST=
# Пароль администратора роутера (тот же, что для веб-интерфейса 192.168.0.1).
TPLINK_PASSWORD=
# Логин роутера (по умолчанию admin).
TPLINK_ADMIN=admin

# --- Режим cloud (TP-Link Cloud, устаревший) ---
# Логин и пароль от аккаунта TP-Link (тот же, что в приложении Tether).
# Нужны только в режиме cloud.
TPLINK_USER=
TPLINK_PASSWORD=
# Эндпоинт TP-Link Cloud (по умолчанию a1.tplinkcloud.com, который отключён).
TPLINK_CLOUD_URL=

# Алиас роутера в аккаунте TP-Link (необязательно, если роутер единственный).
TPLINK_ALIAS=

# ============ Дополнительно ============
# URL Telegram-мини-приложения «Эмодзи-студия» (mini-app/).
# Показывает кнопку WebApp в главном меню. Telegram требует HTTPS:
#   - полный deploy: deploy/install.sh --domain your-domain.com
#   - быстрый вариант: cloudflared tunnel --url http://localhost:8080
# Если пусто или URL не https:// — кнопка не показывается, бот работает без неё.
MINI_APP_URL=

# Промежуток (сек) для авто-обновления кэша статуса роутера.
STATS_INTERVAL=60
